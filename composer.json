{
    "name": "noneym/loggerxo-laravel",
    "description": "Loggerxo SDK for Laravel: exceptions, logs, breadcrumbs and performance transactions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "logging", "error-tracking", "monitoring", "loggerxo"],
    "homepage": "https://loggerxo.com",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/log": "^10.0|^11.0|^12.0",
        "monolog/monolog": "^3.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Noneym\\Loggerxo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noneym\\Loggerxo\\LoggerxoServiceProvider"
            ],
            "aliases": {
                "Loggerxo": "Noneym\\Loggerxo\\Facades\\Loggerxo"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
